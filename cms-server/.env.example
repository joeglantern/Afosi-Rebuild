# Copy to .env on the VPS. Never commit the real file.
# deploy/setup-cms-db.sh writes a real one for you.

NODE_ENV=production

# Loopback only; nginx proxies to it. Check "ss -ltn" before changing.
HOST=127.0.0.1
PORT=8792

# Its own database and role on the local Postgres. No rights anywhere else.
DATABASE_URL=postgresql://afosi_cms:PASSWORD@127.0.0.1:5432/afosi_cms

# ── Better Auth ────────────────────────────────────────────────────────────
# At least 32 characters. Generate: openssl rand -base64 48
# Changing it signs everyone out and invalidates the JWT signing keys.
BETTER_AUTH_SECRET=

# Where the dashboard, and so the auth routes, are served. Session cookies
# are set for this host. Must be https in production.
BETTER_AUTH_URL=https://admin.afosi.org

# Origins allowed to sign in and to make changes. No localhost in production.
TRUSTED_ORIGINS=https://admin.afosi.org

# ── Content API ────────────────────────────────────────────────────────────
# Browser origins allowed to call the API at all (the public site only reads).
CORS_ORIGINS=https://afosi.org,https://www.afosi.org,https://admin.afosi.org

# ── Uploads ────────────────────────────────────────────────────────────────
# Where files are written, and the public URL they are served under.
UPLOAD_DIR=/var/www/afosi-rebuild/cms-server/data/uploads
PUBLIC_UPLOAD_BASE=https://api.afosi.org/uploads
MAX_UPLOAD_MB=100
