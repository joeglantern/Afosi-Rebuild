# Copy this file to server/.env on the VPS and fill in a FRESH OpenAI key.
# server/.env is gitignored — the real key must NEVER be committed.

# Required: your rotated OpenAI API key (create at https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-REPLACE_WITH_A_FRESH_ROTATED_KEY

# Optional (sensible defaults shown)
OPENAI_MODEL=gpt-4o-mini
PORT=8790
HOST=127.0.0.1
AFOSI_API_URL=https://api.afosi.org/api
ALLOWED_ORIGINS=https://afosi.org,https://www.afosi.org

# --- Donations (Paystack) ---------------------------------------------------
# Get these from your Paystack dashboard: Settings > API Keys & Webhooks
# (https://dashboard.paystack.com/#/settings/developers). Leave blank to keep
# donations disabled (the /donate page will show a friendly "not enabled
# yet" message instead of erroring).
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# No separate webhook secret to set — /donate/webhook verifies deliveries by
# re-computing the HMAC with PAYSTACK_SECRET_KEY above, which is what
# Paystack signs webhook bodies with. Just set the webhook URL in the
# dashboard to https://api.afosi.org/donate/webhook.
# Supported currencies (KES/USD) and their minimums/channels are fixed in
# server.js, not env vars — Paystack Kenya only settles in those two.
SITE_URL=https://afosi.org
API_URL=https://api.afosi.org

# --- Opportunity applications (server/applications.js) --------------------
# The built-in application form (src/apply.js) submits here. Documents are
# stored on THIS server's disk (server/uploads/applications/), never on
# public Supabase Storage — they're private and only ever served back out
# through the admin-only download route below.

# Must be the EXACT same value as JWT_SECRET in the ADMIN dashboard's Vercel
# project settings — this server verifies the same login tokens the admin
# dashboard issues, rather than having its own separate admin login. If left
# unset it falls back to the same insecure default ADMIN/api/auth.js falls
# back to; set a real shared secret on both sides before going live.
JWT_SECRET=

# Who gets the "new application" notification email.
HR_EMAIL=careers@afosi.org

# Optional — without this, applications still save and are visible/
# downloadable in the admin dashboard, but no notification emails go out.
# Get a key at https://resend.com/api-keys. RESEND_FROM must be a verified
# sending address/domain on that Resend account.
RESEND_API_KEY=
RESEND_FROM=AFOSI Applications <applications@afosi.org>

# Shown inside the HR notification email as the link to review applications.
ADMIN_DASHBOARD_URL=https://admin.afosi.org

# Origins allowed to call the admin-only /applications/* routes (list/
# download/mark-reviewed) — the ADMIN dashboard's deployed URL(s). Kept
# separate from ALLOWED_ORIGINS above, which is for the public site.
ADMIN_ORIGINS=https://admin.afosi.org

# --- Image proxy (server/imgproxy.js) -------------------------------------
# Resizes/recompresses gallery & news photos hosted on Supabase Storage.
# Comma-separated list of hostnames it's allowed to fetch from (prevents this
# becoming an open image-fetching proxy). Only needs changing if AFOSI moves
# to a different Supabase project.
IMG_ALLOWED_HOSTS=pmigmljjnyucethipdtk.supabase.co
