# Copy this file to server/.env on the VPS and fill in a FRESH OpenAI key.
# server/.env is gitignored — the real key must NEVER be committed.

# Required: your rotated OpenAI API key (create at https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-REPLACE_WITH_A_FRESH_ROTATED_KEY

# Optional (sensible defaults shown)
OPENAI_MODEL=gpt-4o-mini
PORT=8790
HOST=127.0.0.1
AFOSI_API_URL=https://api.afosi.org/api
ALLOWED_ORIGINS=https://afosi.org,https://www.afosi.org

# --- Donations (Pesapal) --------------------------------------------------
# Get these from your Pesapal merchant dashboard: https://developer.pesapal.com/
# Leave blank to keep donations disabled (the /donate page will show a
# friendly "not enabled yet" message instead of erroring).
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
# sandbox while testing, live once you're ready to take real payments
PESAPAL_ENV=sandbox
# Leave blank on first run — the server auto-registers the IPN url and prints
# the id to the logs. Paste it here afterwards so it isn't re-registered on
# every restart.
PESAPAL_IPN_ID=
DONATE_CURRENCY=KES
DONATE_MIN_AMOUNT=50
# Public URLs used to build Pesapal's callback/IPN links
SITE_URL=https://afosi.org
API_URL=https://api.afosi.org

# --- Image proxy (server/imgproxy.js) -------------------------------------
# Resizes/recompresses gallery & news photos hosted on Supabase Storage.
# Comma-separated list of hostnames it's allowed to fetch from (prevents this
# becoming an open image-fetching proxy). Only needs changing if AFOSI moves
# to a different Supabase project.
IMG_ALLOWED_HOSTS=pmigmljjnyucethipdtk.supabase.co
