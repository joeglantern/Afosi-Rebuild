# Backend API URL
# For local development: http://localhost:5000/api
# For production: https://api.afosi.org/api
VITE_API_URL=https://api.afosi.org/api

# Applications tab — talks to the project's own VPS service (server/applications.js),
# NOT the serverless functions above. Requires JWT_SECRET on that VPS to match
# this dashboard's own JWT_SECRET (see server/.env.example / server/README.md).
VITE_APPLICATIONS_API_URL=https://api.afosi.org/applications
