# Dependencies
node_modules/

# Build output (built on the server)
dist/

# Local tooling / editor
.claude/
.vscode/
.idea/
*.log

# Env / secrets
.env
.env.*
!.env.example

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# stray screenshots
image.png

# Runtime image proxy cache (server/imgproxy.js) — regenerated on demand
server/img-cache/

# Donation state (server/donations-store.js) — regenerated from Paystack
server/donations-store.json

# Application submissions + uploaded documents (server/applications-store.js,
# server/applications.js) — private applicant data, never committed
server/applications-store.json
server/uploads/

AFOSI Podcast Terms of Reference.docx
OPEN_ENDED_DEADLINE_FEATURE.md
AFOSI- STRATEGIC OBJECTIVES.docx

# Printable barcode asset tags: regenerated from public/data/assets.json by
# tools/build-asset-tags.py, and large. The register JSON is the source of truth
# and IS committed; these are just its output.
asset-tags/
AFOSI-asset-tags.zip

# Quiz service: real responses and the database credentials never go in git.
quiz-server/.env
quiz-server/data/

# CMS service: database credentials, auth secret and uploaded files never go
# in git. Uploads are content, backed up with the server, not the repo.
cms-server/.env
cms-server/data/
