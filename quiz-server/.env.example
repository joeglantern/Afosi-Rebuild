# Copy to .env on the VPS. Never commit the real file.
#
# deploy/setup-quiz-db.sh creates the role and database and writes the real
# .env for you, so normally you do not fill this in by hand.

# Port this service listens on. It binds to 127.0.0.1 only; nginx proxies to
# it. Picked because nothing else on the box uses it; check with "ss -ltn"
# before changing.
PORT=8791

# Its own database and role. No rights over any other database on the server.
DATABASE_URL=postgresql://afosi_quiz:PASSWORD_HERE@127.0.0.1:5432/afosi_quiz

# Browser origins allowed to call the API. The quiz pages are served from the
# static site, so they call this service cross origin.
QUIZ_ORIGINS=https://afosi.org,https://www.afosi.org

# The presenter's key for /quiz/results. Anyone with this can read every
# response and the names people typed, so treat it like a password.
# Generate one with: openssl rand -hex 24
QUIZ_RESULTS_KEY=
